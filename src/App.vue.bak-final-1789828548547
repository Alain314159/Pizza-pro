<template>
  <div v-cloak :data-theme="cfg.tema">
    <!-- SPLASH -->
    <div v-if="splashVisible" class="splash-screen">
      <div class="splash-logo"><icon name="fire" :size="48" color="#fff"></icon></div>
      <div class="splash-title">{{ cfg.nombre || 'Pizza Pro' }}</div>
      <div class="splash-spinner"></div>
    </div>

    <!-- HEADER -->
    <header class="header no-print">
      <h1><icon name="fire" :size="20" color="#fff"></icon> {{ cfg.nombre || 'Pizza Pro' }}</h1>
      <div class="hacts">
        <button class="h-btn" @click="toggleTema()">
          <icon :name="cfg.tema === 'dark' ? 'sun' : 'moon'" :size="18" color="#fff"></icon>
        </button>
        <button class="h-btn" @click="ajustesAbierto = true">
          <icon name="settings" :size="18" color="#fff"></icon>
        </button>
      </div>
    </header>

    <main @touchstart.passive="onTouchStart" @touchmove.passive="onTouchMove" @touchend="onTouchEnd">
      <!-- ==================== DASHBOARD ==================== -->
      <section v-if="sec === 'dashboard'" class="fade-up">
        <div class="balance azul">
          <div class="lbl"><icon name="wallet" :size="14" color="#fff"></icon> Efectivo en Caja</div>
          <div class="val">{{ fmt(saldoCaja) }}</div>
          <div class="sub">Insumos: {{ fmt(valorInsumos) }} · Desde {{ fmtFecha(cfg.periodoInicio) }}</div>
        </div>

        <div v-if="insumosBajoStock.length" class="alert-box-stock">
          <div class="alert-chip alert-low" @click="ir('inventario')">
            <icon name="alert" :size="14" color="#fff"></icon>
            <b>{{ insumosBajoStock.length }}</b> insumo(s) bajo(s)
          </div>
        </div>

        <div class="grid2">
          <div class="stat">
            <div class="lbl"><icon name="cart" :size="12"></icon> Pizzas vendidas</div>
            <div class="val" style="color:var(--pri)">{{ pizzasVendidasPeriodo }}</div>
          </div>
          <div class="stat">
            <div class="lbl"><icon name="dollar" :size="12"></icon> Ganancia neta</div>
            <div class="val" :class="gananciaNetaPeriodo >= 0 ? 'pos' : 'neg'">{{ fmt(gananciaNetaPeriodo) }}</div>
          </div>
          <div class="stat">
            <div class="lbl"><icon name="trend" :size="12"></icon> Ventas</div>
            <div class="val">{{ fmt(ventasPeriodo) }}</div>
          </div>
          <div class="stat">
            <div class="lbl"><icon name="x" :size="12"></icon> Bajas</div>
            <div class="val neg">{{ bajasPeriodo }}</div>
          </div>
        </div>

        <div class="card" style="margin-top:.8rem">
          <div class="card-title"><icon name="zap" :size="18" color="#D97706"></icon> Accesos rápidos</div>
          <div class="quick-grid">
            <button class="quick-btn" @click="ir('ventas')"><icon name="cart" :size="22"></icon>Nueva Venta</button>
            <button class="quick-btn" @click="ir('bajas')"><icon name="x" :size="22"></icon>Registrar Baja</button>
            <button class="quick-btn" @click="ir('compras')"><icon name="bag" :size="22"></icon>Compra Insumo</button>
            <button class="quick-btn" @click="ir('auditoria')"><icon name="check" :size="22"></icon>Auditoría</button>
          </div>
        </div>

        <div class="card" v-if="insumosBajoStock.length">
          <div class="card-title"><icon name="alert" :size="18" color="#D97706"></icon> Insumos bajo stock</div>
          <div v-for="i in insumosBajoStock" :key="i.id" class="item">
            <div class="info">
              <div class="nm">{{ i.nombre }}</div>
              <div class="det">Stock: {{ fmtCant(stockInsumo(i.id)) }} {{ i.unidad }} · Mín: {{ fmtCant(i.stockMinimo) }}</div>
            </div>
            <span class="badge low">BAJO</span>
          </div>
        </div>
      </section>

      <!-- ==================== VENTAS ==================== -->
      <section v-if="sec === 'ventas'" class="fade-up">
        <div class="card">
          <div class="card-title"><icon name="cart" :size="18" color="#D97706"></icon> Nueva Venta</div>
          <div class="search">
            <input :value="busqVenta" @input="busqVenta = $event.target.value" type="text" placeholder="Buscar pizza..." autocomplete="off">
          </div>
          <div v-if="busqVenta" class="drop-static">
            <div class="drop-head"><span>{{ listaVenta.length }} resultado(s)</span><button @click="busqVenta = ''">×</button></div>
            <div v-if="listaVenta.length === 0" class="empty">Sin coincidencias</div>
            <div v-for="p in listaVenta" :key="p.id" class="drop-item" @click="agregarCarrito(p)">
              <span>{{ p.nombre }}</span>
              <span style="color:var(--mut)">{{ fmt(p.precio) }}</span>
            </div>
          </div>

          <div v-if="carrito.length" style="margin-top:.5rem">
            <div v-for="(it, i) in carrito" :key="i" class="cart-item">
              <div class="cart-top">
                <div class="nm">{{ it.nombre }}</div>
                <button class="del-btn" @click="carrito.splice(i, 1)"><icon name="x" :size="14" color="#fff"></icon></button>
              </div>
              <div class="cart-controls">
                <div class="cart-field">
                  <label>Cantidad</label>
                  <div class="qty-input">
                    <button type="button" @click="cambiarCant(it, -1)">−</button>
                    <input :value="it.cant" type="number" inputmode="decimal" @input="it.cant = $event.target.value">
                    <button type="button" @click="cambiarCant(it, 1)">+</button>
                  </div>
                </div>
                <div class="cart-field">
                  <label>Precio</label>
                  <input class="price-input" :value="it.precio" type="number" inputmode="decimal" @input="it.precio = $event.target.value">
                </div>
              </div>
              <div class="cart-total-line">
                <span>{{ fmt(it.precio) }} × {{ fmtCant(it.cant) }} = <b style="color:var(--pri)">{{ fmt(subTotalItem(it)) }}</b></span>
              </div>
            </div>
            <div class="total-box">
              <span>TOTAL {{ fmt(totalCarrito) }}</span>
              <span>Gan. {{ fmt(gananciaCarrito) }}</span>
            </div>
            <button class="btn ok" @click="iniciarCobro()" :disabled="procesandoVenta">
              {{ procesandoVenta ? 'Procesando...' : 'Cobrar Venta' }}
            </button>
            <button class="btn ghost" @click="carrito = []">Limpiar carrito</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title"><icon name="list" :size="18" color="#D97706"></icon> Historial de ventas</div>
          <div v-if="ventasOrdenadas.length === 0" class="empty">Sin ventas</div>
          <div v-for="v in ventasOrdenadas.slice(0, 20)" :key="v.id" class="item" :class="{ anulada: v.anulada }">
            <div class="info">
              <div class="nm">{{ v.items.map(x => x.nombre + ' ×' + fmtCant(x.cantidad)).join(', ') }}</div>
              <div class="det">{{ fmtFH(v.fecha) }} · <b style="color:var(--pri)">{{ fmt(v.total) }}</b> · <span class="pos">+{{ fmt(v.ganancia) }}</span></div>
            </div>
            <button v-if="!v.anulada" class="link-btn" @click="anularVenta(v.id)">Anular</button>
            <span v-else class="badge arch">ANULADA</span>
          </div>
        </div>
      </section>

      <!-- ==================== COMPRAS ==================== -->
      <section v-if="sec === 'compras'" class="fade-up">
        <div class="card">
          <div class="card-title"><icon name="bag" :size="18" color="#D97706"></icon> Registrar Compra de Insumo</div>
          <select v-model="compraForm.insumoId" @change="selCompraInsumo">
            <option value="">Seleccionar insumo...</option>
            <option v-for="i in insumosActivos" :key="i.id" :value="i.id">{{ i.nombre }} ({{ i.unidad }})</option>
          </select>
          <div v-if="compraForm.insumoId">
            <div class="grid2">
              <input v-model="compraForm.pesoBruto" type="number" inputmode="decimal" step="0.01" placeholder="Peso bruto (con envase)">
              <input v-model="compraForm.pesoEnvase" type="number" inputmode="decimal" step="0.01" placeholder="Peso envase">
            </div>
            <div class="row" style="border:none;padding:.2rem 0">
              <span>Cantidad neta</span>
              <b>{{ fmtCant(compraCantidadNeta()) }} {{ compraForm.unidad }}</b>
            </div>
            <input v-model="compraForm.costoTotal" type="number" inputmode="decimal" step="0.01" placeholder="Costo total pagado">
            <div class="row" style="border:none;padding:.2rem 0">
              <span>Costo por {{ compraForm.unidad }}</span>
              <b>{{ fmt(compraCostoUnitario()) }}</b>
            </div>
            <button class="btn pri" @click="guardarCompra()">Registrar Compra</button>
            <button class="btn ghost" @click="resetCompra()">Cancelar</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title"><icon name="list" :size="18" color="#D97706"></icon> Historial de compras</div>
          <div v-if="comprasOrdenadas.length === 0" class="empty">Sin compras</div>
          <div v-for="c in comprasOrdenadas.slice(0, 20)" :key="c.id" class="item">
            <div class="info">
              <div class="nm">{{ c.insumoNombre }}</div>
              <div class="det">{{ fmtFH(c.fecha) }} · {{ fmtCant(c.cantidad) }} {{ c.unidad }}</div>
            </div>
            <b class="neg">{{ fmt(c.total) }}</b>
          </div>
        </div>
      </section>

      <!-- ==================== INVENTARIO INSUMOS ==================== -->
      <section v-if="sec === 'inventario'" class="fade-up">
        <div class="balance verde">
          <div class="lbl"><icon name="package" :size="14" color="#fff"></icon> Valor del Inventario</div>
          <div class="val">{{ fmt(valorInsumos) }}</div>
          <div class="sub">{{ insumosActivos.length }} insumos · {{ lotesActivos.length }} lotes</div>
        </div>

        <div class="card">
          <div class="card-title"><icon name="package" :size="18" color="#D97706"></icon> Insumos</div>
          <div v-if="insumosActivos.length === 0" class="empty">Sin insumos</div>
          <div v-for="i in insumosActivos" :key="i.id" class="item">
            <div class="info">
              <div class="nm">{{ i.nombre }}</div>
              <div class="det">Stock: {{ fmtCant(stockInsumo(i.id)) }} {{ i.unidad }} · Mín: {{ fmtCant(i.stockMinimo) }}</div>
            </div>
            <span class="badge" :class="badgeStockInsumo(i)">{{ txtBadgeInsumo(i) }}</span>
          </div>
        </div>

        <div class="card">
          <div class="card-title"><icon name="plus" :size="18" color="#D97706"></icon> Agregar insumo</div>
          <input v-model="insumoForm.nombre" type="text" placeholder="Nombre (ej: Harina)">
          <select v-model="insumoForm.unidad">
            <option value="g">Gramos (g)</option>
            <option value="ml">Mililitros (ml)</option>
            <option value="u">Unidades (u)</option>
          </select>
          <select v-model="insumoForm.categoria">
            <option value="">Categoría...</option>
            <option v-for="c in categoriasInsumo" :key="c" :value="c">{{ c }}</option>
          </select>
          <input v-model="insumoForm.stockMinimo" type="number" inputmode="decimal" placeholder="Stock mínimo">
          <input v-model="insumoForm.pesoEnvase" type="number" inputmode="decimal" placeholder="Peso envase (opcional)">
          <button class="btn pri" @click="guardarInsumo()">Guardar Insumo</button>
        </div>
      </section>

      <!-- ==================== BAJAS ==================== -->
      <section v-if="sec === 'bajas'" class="fade-up">
        <div class="card">
          <div class="card-title"><icon name="x" :size="18" color="#D97706"></icon> Registrar Baja</div>
          <select v-model="bajaForm.productoId">
            <option value="">Seleccionar producto...</option>
            <option v-for="p in productosActivos" :key="p.id" :value="p.id">{{ p.nombre }}</option>
          </select>
          <input v-model="bajaForm.cantidad" type="number" inputmode="numeric" placeholder="Cantidad">
          <select v-model="bajaForm.motivo">
            <option value="">Motivo...</option>
            <option v-for="mot in motivosBaja" :key="mot.value" :value="mot.value">{{ mot.label }}</option>
          </select>
          <input v-model="bajaForm.nota" type="text" placeholder="Nota (opcional)">
          <button class="btn warn" @click="registrarBaja()">Registrar Baja</button>
        </div>

        <div class="card">
          <div class="card-title"><icon name="list" :size="18" color="#D97706"></icon> Historial de bajas</div>
          <div v-if="bajasOrdenadas.length === 0" class="empty">Sin bajas</div>
          <div v-for="b in bajasOrdenadas.slice(0, 20)" :key="b.id" class="item">
            <div class="info">
              <div class="nm">{{ b.productoNombre }} × {{ b.cantidad }}</div>
              <div class="det">{{ fmtFH(b.fecha) }} · {{ labelMotivo(b.motivo) }}</div>
            </div>
            <b class="neg">-{{ fmt(b.costoPerdida) }}</b>
          </div>
        </div>
      </section>

      <!-- ==================== PRODUCTOS ==================== -->
      <section v-if="sec === 'productos'" class="fade-up">
        <div class="card">
          <div class="card-title"><icon name="tag" :size="18" color="#D97706"></icon> {{ prodForm.editId ? 'Editar' : 'Agregar' }} Producto</div>
          <input v-model="prodForm.nombre" type="text" placeholder="Nombre (ej: Pizza Cubana)">
          <input v-model="prodForm.precio" type="number" inputmode="decimal" step="0.01" placeholder="Precio de venta">
          <div class="escalones-box">
            <div class="escalones-header">
              <span>Receta</span>
              <button class="link-btn" @click.prevent="agregarIngredienteReceta()">+ Agregar insumo</button>
            </div>
            <div v-if="!prodForm.receta || !prodForm.receta.length" class="det" style="font-size:.72rem;color:var(--mut);padding:.4rem 0">
              Sin receta definida.
            </div>
            <div v-for="(r, i) in prodForm.receta" :key="i" class="escalon-row">
              <select v-model="r.insumoId" style="flex:1">
                <option value="">Insumo...</option>
                <option v-for="ins in insumosActivos" :key="ins.id" :value="ins.id">{{ ins.nombre }}</option>
              </select>
              <input v-model="r.cantidad" type="number" inputmode="decimal" step="0.01" placeholder="Cant." style="width:70px">
              <label style="display:flex;align-items:center;gap:.2rem;font-size:.65rem">
                <input type="checkbox" v-model="r.fijo" style="width:auto;margin:0"> Fijo
              </label>
              <button class="icon-btn bad" @click.prevent="quitarIngredienteReceta(i)"><icon name="x" :size="14" color="#dc2626"></icon></button>
            </div>
          </div>
          <button class="btn pri" @click="guardarProducto()">{{ prodForm.editId ? 'Actualizar' : 'Guardar' }}</button>
          <button v-if="prodForm.editId" class="btn ghost" @click="resetProd()">Cancelar</button>
        </div>

        <div class="card">
          <div class="card-title"><icon name="tag" :size="18" color="#D97706"></icon> Productos</div>
          <div v-if="productosActivos.length === 0" class="empty">Sin productos</div>
          <div v-for="p in productosActivos" :key="p.id" class="item">
            <div class="info">
              <div class="nm">{{ p.nombre }}</div>
              <div class="det">{{ fmt(p.precio) }} · {{ (p.receta || []).length }} insumo(s)</div>
            </div>
            <div class="act-btns">
              <button class="icon-btn" @click="editarProducto(p.id)"><icon name="edit" :size="15"></icon></button>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== AUDITORIA ==================== -->
      <section v-if="sec === 'auditoria'" class="fade-up">
        <div v-if="!auditActiva" class="card">
          <div class="card-title"><icon name="check" :size="18" color="#D97706"></icon> Iniciar Auditoría</div>
          <div class="info-box">
            Cuenta los insumos físicos. La app calcula la diferencia y ajusta las recetas automáticamente.
          </div>
          <button class="btn pri" @click="iniciarAuditoria()">Nueva Auditoría</button>
        </div>

        <div v-else>
          <div class="card">
            <div class="card-title"><icon name="scale" :size="18" color="#D97706"></icon> Conteo de insumos</div>
            <div v-for="item in auditConteoActual" :key="item.insumoId" class="audit-item">
              <div style="flex:1;min-width:0">
                <div class="nm" style="font-size:.85rem;font-weight:700">{{ item.nombre }}</div>
                <div class="det" style="font-size:.7rem;color:var(--mut)">Teórico: {{ fmtCant(item.stockTeorico) }} {{ item.unidad }}</div>
              </div>
              <input type="number" inputmode="decimal" step="0.01" class="audit-input"
                :value="auditForm.conteos[item.insumoId]?.contado ?? ''"
                @input="setAuditConteo(item.insumoId, $event.target.value)"
                placeholder="real" style="width:80px;margin:0">
            </div>
            <div class="grid2" style="margin-top:.6rem">
              <button class="btn ghost" @click="cancelarAuditoria()">Cancelar</button>
              <button class="btn pri" @click="cerrarAuditoria()">Cerrar Auditoría</button>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-title"><icon name="list" :size="18" color="#D97706"></icon> Historial</div>
          <div v-if="auditoriasOrdenadas.length === 0" class="empty">Sin auditorías</div>
          <div v-for="a in auditoriasOrdenadas" :key="a.id" class="item">
            <div class="info">
              <div class="nm">{{ fmtFH(a.fecha) }}</div>
              <div class="det">{{ a.ajustesRecetas?.length || 0 }} receta(s) ajustada(s)</div>
            </div>
            <b :class="a.mermaExplicada ? 'pos' : 'neg'">{{ a.mermaExplicada ? 'OK' : 'REVISAR' }}</b>
          </div>
        </div>
      </section>

      <!-- ==================== CAJA ==================== -->
      <section v-if="sec === 'caja'" class="fade-up">
        <div class="balance azul">
          <div class="lbl"><icon name="wallet" :size="14" color="#fff"></icon> Efectivo en Caja</div>
          <div class="val">{{ fmt(saldoCaja) }}</div>
          <div class="sub">Capital: {{ fmt(cfg.capitalInicial || 0) }}</div>
        </div>

        <div class="card">
          <div class="card-title"><icon name="wallet" :size="18" color="#D97706"></icon> Arqueo de Caja</div>
          <input v-model="arqueoForm.monto" type="number" inputmode="decimal" step="0.01" placeholder="Monto contado físicamente">
          <div v-if="arqueoForm.monto !== ''" class="arqueo-prev" :class="arqueoPreview.class">
            Diferencia: <b>{{ fmt(arqueoPreview.diff) }}</b>
          </div>
          <input v-model="arqueoForm.nota" type="text" placeholder="Nota (opcional)">
          <button class="btn pri" @click="registrarArqueo()">Registrar Arqueo</button>
        </div>

        <div class="card">
          <div class="card-title"><icon name="list" :size="18" color="#D97706"></icon> Movimientos recientes</div>
          <div v-if="movCajaRecientes.length === 0" class="empty">Sin movimientos</div>
          <div v-for="m in movCajaRecientes" :key="m.id" class="item">
            <div class="info">
              <div class="nm">{{ m.concepto }}</div>
              <div class="det">{{ fmtFH(m.fecha) }}</div>
            </div>
            <b :class="m.tipo === 'ingreso' ? 'pos' : 'neg'">{{ m.tipo === 'ingreso' ? '+' : '-' }}{{ fmt(m.monto) }}</b>
          </div>
        </div>
      </section>

      <!-- ==================== GASTOS ==================== -->
      <section v-if="sec === 'gastos'" class="fade-up">
        <div class="balance morado">
          <div class="lbl"><icon name="dollar" :size="14" color="#fff"></icon> Gastos del período</div>
          <div class="val">{{ fmt(gastosPeriodo) }}</div>
          <div class="sub">{{ gastos.length }} registro(s)</div>
        </div>

        <div class="card">
          <div class="card-title"><icon name="plus" :size="18" color="#D97706"></icon> Registrar Gasto</div>
          <input v-model="gastoForm.fecha" type="date">
          <select v-model="gastoForm.categoria">
            <option value="">Categoría...</option>
            <option v-for="c in categoriasGasto" :key="c" :value="c">{{ c }}</option>
          </select>
          <input v-model="gastoForm.concepto" type="text" placeholder="Concepto">
          <input v-model="gastoForm.monto" type="number" inputmode="decimal" step="0.01" placeholder="Monto">
          <div class="set-row">
            <span class="lbl">Sale de caja</span>
            <label class="switch"><input type="checkbox" v-model="gastoForm.saleDeCaja"><span class="slider"></span></label>
          </div>
          <button class="btn warn" @click="guardarGasto()">Registrar Gasto</button>
        </div>

        <div class="card">
          <div class="card-title"><icon name="list" :size="18" color="#D97706"></icon> Historial</div>
          <div v-if="gastosOrdenados.length === 0" class="empty">Sin gastos</div>
          <div v-for="g in gastosOrdenados.slice(0, 20)" :key="g.id" class="item">
            <div class="info">
              <div class="nm">{{ g.categoria }} · {{ g.concepto }}</div>
              <div class="det">{{ fmtFH(g.fecha) }} · {{ g.saleDeCaja ? 'Caja' : 'Sin caja' }}</div>
            </div>
            <b class="neg">-{{ fmt(g.monto) }}</b>
          </div>
        </div>
      </section>

      <!-- ==================== SOCIOS ==================== -->
      <section v-if="sec === 'socios'" class="fade-up">
        <SeccionSocios />
      </section>

      <!-- ==================== REPORTES ==================== -->
      <section v-if="sec === 'reportes'" class="fade-up">
        <div class="card">
          <div class="card-title"><icon name="file" :size="18" color="#D97706"></icon> Reporte del período</div>
          <div class="grid2">
            <input v-model="rep.fechaInicio" type="date">
            <input v-model="rep.fechaFin" type="date">
          </div>
          <button class="btn pri" @click="generarReporte()">Generar Reporte</button>
        </div>

        <div v-if="rep.resultado" class="card">
          <div class="card-title"><icon name="chart" :size="18" color="#D97706"></icon> Resultado</div>
          <div class="row"><span>Ingresos</span><b class="pos">{{ fmt(rep.resultado.ingresos) }}</b></div>
          <div class="row"><span>Costo insumos</span><b class="neg">-{{ fmt(rep.resultado.costoInsumos) }}</b></div>
          <div class="row"><span>Bajas</span><b class="neg">-{{ fmt(rep.resultado.bajas) }}</b></div>
          <div class="row"><span>Gastos</span><b class="neg">-{{ fmt(rep.resultado.gastos) }}</b></div>
          <div class="row total"><span>Ganancia neta</span><span :class="rep.resultado.neta >= 0 ? 'pos' : 'neg'">{{ fmt(rep.resultado.neta) }}</span></div>
          <div class="det" style="font-size:.75rem;color:var(--mut);margin-top:.3rem">Pizzas vendidas: {{ rep.resultado.numVentas }}</div>
        </div>
      </section>
    </main>

    <!-- BOTTOM NAV -->
    <BottomNav :sec="sec" :mas-activo="masActivo" @ir="ir" @toggle-mas="masAbierto = !masAbierto" />

    <!-- SHEET MAS -->
    <SheetMas :abierto="masAbierto" :sec="sec" @cerrar="masAbierto = false" @ir="ir" @abrir-ajustes="masAbierto = false; ajustesAbierto = true" />

    <!-- MODAL AJUSTES -->
    <div v-if="ajustesAbierto" class="modal no-print" @click.self="ajustesAbierto = false">
      <div class="modal-box" @click.stop>
        <div class="modal-title"><icon name="settings" :size="20"></icon> Ajustes</div>

        <div class="set-group">Tienda</div>
        <div class="set-row">
          <span class="lbl">Nombre</span>
          <input v-model="cfg.nombre" type="text" style="width:auto;flex:1;margin:0;padding:.4rem .6rem" @change="guardarCfg">
        </div>
        <div class="set-row">
          <span class="lbl">Capital inicial</span>
          <input :value="cfg.capitalInicial || 0" @change="setCapitalInicial($event.target.value)" type="number" style="width:auto;flex:1;margin:0;padding:.4rem .6rem">
        </div>

        <div class="set-group">Alertas</div>
        <div class="set-row">
          <span class="lbl">Umbral merma (%)</span>
          <input v-model.number="cfg.umbralMermaPct" type="number" min="1" max="100" style="width:5rem;margin:0;padding:.3rem .5rem" @change="guardarCfg">
        </div>

        <div class="set-group">Datos</div>
        <button class="btn pri" @click="exportar">Exportar respaldo (JSON)</button>
        <button class="btn ghost" @click="triggerImport">Importar datos</button>
        <input type="file" id="impFile" accept=".json" style="display:none" @change="onImportFile">

        <div class="set-group">Zona peligrosa</div>
        <button class="btn bad" @click="borrarTodo">Borrar TODOS los datos</button>

        <button class="btn ghost" style="margin-top:.8rem" @click="ajustesAbierto = false">Cerrar</button>
      </div>
    </div>

    <!-- COBRO MODAL -->
    <div v-if="cobroModal.activo" class="modal no-print">
      <div class="modal-box">
        <div class="modal-title"><icon name="check" :size="20"></icon> Cobrar Venta</div>
        <div class="cobro-modal">Total: {{ fmt(cobroModal.total) }}</div>
        <button class="btn ok" @click="procesarVenta" :disabled="procesandoVenta">
          {{ procesandoVenta ? 'Procesando...' : 'Confirmar Pago' }}
        </button>
        <button class="btn ghost" @click="cobroModal.activo = false">Cancelar</button>
      </div>
    </div>

    <!-- MODALES DE SOCIOS -->
    <ModalRetiro />
    <ModalAporte />

    <!-- CONFIRM / PROMPT -->
    <ModalConfirm :activo="confirm.activo" :titulo="confirm.titulo" :msg="confirm.msg" @ok="okConfirm" @cancelar="confirm.activo = false" />
    <ModalPrompt :activo="prompt.activo" :titulo="prompt.titulo" :msg="prompt.msg" :placeholder="prompt.placeholder" :type="prompt.type" :value="prompt.value" @update:value="prompt.value = $event" @ok="okPrompt" @cancelar="cancelPrompt" />

    <!-- TOAST -->
    <AppToast :toast="toast" @accion="toast.accionFn && toast.accionFn(); toast.show = false" />
  </div>
</template>

<script>
import { db, n, m, q, genId, clean, P, vib, fmt, fmtCant, fmtFecha, fmtFH, buildData } from './db.js';
import { TOAST, CATEGORIAS_GASTO, MOTIVOS_BAJA, UNIDADES, CATEGORIAS_INSUMO } from './constants.js';
import BottomNav from './components/BottomNav.vue';
import SheetMas from './components/SheetMas.vue';
import ModalConfirm from './components/ModalConfirm.vue';
import ModalPrompt from './components/ModalPrompt.vue';
import AppToast from './components/AppToast.vue';
import SeccionSocios from './components/SeccionSocios.vue';
import ModalRetiro from './components/ModalRetiro.vue';
import ModalAporte from './components/ModalAporte.vue';
import sociosMixin from './mixins/socios.js';

export default {
  name: 'App',
  mixins: [sociosMixin],
  components: { BottomNav, SheetMas, ModalConfirm, ModalPrompt, AppToast, SeccionSocios, ModalRetiro, ModalAporte },

  data() {
    return {
      online: navigator.onLine,
      cargando: true,
      sec: 'dashboard',
      masAbierto: false,
      ajustesAbierto: false,
      splashVisible: true,
      _pullStartY: 0,
      _pulling: false,
      pullDist: 0,
      refrescando: false,

      cfg: {
        nombre: 'Pizza Pro',
        tema: 'light',
        capitalInicial: 0,
        periodoInicio: new Date().toISOString(),
        umbralMermaPct: 15,
        stockMinDefault: 500,
        ultimoBackupAuto: null
      },

      insumos: [],
      lotesInsumo: [],
      productos: [],
      ventas: [],
      compras: [],
      bajas: [],
      gastos: [],
      movCaja: [],
      arqueos: [],
      auditorias: [],
      auditActiva: null,

      // Ventas
      busqVenta: '',
      carrito: [],
      procesandoVenta: false,

      // Compras
      compraForm: { insumoId: '', insumoNombre: '', unidad: 'g', pesoBruto: '', pesoEnvase: '', costoTotal: '' },

      // Insumos
      insumoForm: { nombre: '', unidad: 'g', categoria: '', stockMinimo: '', pesoEnvase: '' },

      // Productos
      prodForm: { editId: '', nombre: '', precio: '', receta: [] },

      // Bajas
      bajaForm: { productoId: '', cantidad: '', motivo: '', nota: '' },

      // Auditoría
      auditForm: { conteos: {} },

      // Caja
      arqueoForm: { monto: '', nota: '' },
      arqueoPreview: { diff: 0, class: 'cuadre' },

      // Gastos
      gastoForm: { fecha: new Date().toISOString().split('T')[0], categoria: '', concepto: '', monto: '', saleDeCaja: true },

      // Reportes
      rep: { fechaInicio: new Date().toISOString().split('T')[0], fechaFin: new Date().toISOString().split('T')[0], resultado: null },

      // Modales
      cobroModal: { activo: false, total: 0 },
      confirm: { activo: false, titulo: '', msg: '', onOk: null },
      prompt: { activo: false, titulo: '', msg: '', placeholder: '', type: 'text', value: '', onOk: null },
      toast: { show: false, msg: '', type: 'ok', accionTxt: '', accionFn: null, timer: null },

      // Constantes
      categoriasGasto: CATEGORIAS_GASTO,
      motivosBaja: MOTIVOS_BAJA,
      unidades: UNIDADES,
      categoriasInsumo: CATEGORIAS_INSUMO,

      _chart: null,
      _stockCache: null
    };
  },

  computed: {
    insumosActivos() { return this.insumos.filter(i => !i.archivado); },
    productosActivos() { return this.productos.filter(p => !p.archivado); },

    stockInsumosMap() {
      const cache = this._stockCache;
      if (cache && cache._v === this.lotesInsumo && cache._i === this.insumos) return cache.data;
      const map = {};
      this.insumos.forEach(i => { map[i.id] = 0; });
      this.lotesInsumo.forEach(l => {
        if (map[l.insumoId] !== undefined) {
          map[l.insumoId] += (n(l.cantidadInicial) - n(l.cantidadUsada));
        }
      });
      this._stockCache = { _v: this.lotesInsumo, _i: this.insumos, data: map };
      return map;
    },

    valorInsumos() {
      return m(this.lotesInsumo.reduce((s, l) => s + ((n(l.cantidadInicial) - n(l.cantidadUsada)) * n(l.costo)), 0));
    },

    lotesActivos() {
      return this.lotesInsumo.filter(l => (n(l.cantidadInicial) - n(l.cantidadUsada)) > 0);
    },

    insumosBajoStock() {
      return this.insumosActivos.filter(i => {
        const s = this.stockInsumo(i.id);
        return s > 0 && s <= n(i.stockMinimo);
      });
    },

    // Caja
    saldoCaja() {
      const ini = n(this.cfg.capitalInicial);
      const ventasC = this.ventas.filter(v => !v.anulada).reduce((s, v) => s + n(v.total), 0);
      const compras = this.compras.reduce((s, c) => s + n(c.total), 0);
      const gastosCaja = this.gastos.filter(g => g.saleDeCaja !== false).reduce((s, g) => s + n(g.monto), 0);
      const arq = this.movCaja.filter(mv => mv.tipo === 'ingreso').reduce((s, mv) => s + n(mv.monto), 0)
        - this.movCaja.filter(mv => mv.tipo === 'egreso').reduce((s, mv) => s + n(mv.monto), 0);
      return m(ini + ventasC - compras - gastosCaja + arq);
    },

    // Período
    ventasPeriodo() {
      const ini = new Date(this.cfg.periodoInicio);
      return m(this.ventas.filter(v => !v.anulada && new Date(v.fecha) >= ini).reduce((s, v) => s + n(v.total), 0));
    },

    pizzasVendidasPeriodo() {
      const ini = new Date(this.cfg.periodoInicio);
      return this.ventas.filter(v => !v.anulada && new Date(v.fecha) >= ini)
        .reduce((s, v) => s + v.items.reduce((ss, it) => ss + n(it.cantidad), 0), 0);
    },

    costoInsumosPeriodo() {
      const ini = new Date(this.cfg.periodoInicio);
      return m(this.ventas.filter(v => !v.anulada && new Date(v.fecha) >= ini)
        .reduce((s, v) => s + v.items.reduce((ss, it) => ss + n(it.costo), 0), 0));
    },

    bajasPeriodo() {
      const ini = new Date(this.cfg.periodoInicio);
      return this.bajas.filter(b => new Date(b.fecha) >= ini)
        .reduce((s, b) => s + n(b.cantidad), 0);
    },

    gastosPeriodo() {
      const ini = new Date(this.cfg.periodoInicio);
      return m(this.gastos.filter(g => new Date(g.fecha) >= ini).reduce((s, g) => s + n(g.monto), 0));
    },

    gananciaNetaPeriodo() {
      return m(this.ventasPeriodo - this.costoInsumosPeriodo - this.gastosPeriodo);
    },

    // Listas
    ventasOrdenadas() {
      return this.ventas.slice().sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
    },

    comprasOrdenadas() {
      return this.compras.slice().sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
    },

    bajasOrdenadas() {
      return this.bajas.slice().sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
    },

    gastosOrdenados() {
      return this.gastos.slice().sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
    },

    movCajaRecientes() {
      return this.movCaja.slice().sort((a, b) => new Date(b.fecha) - new Date(a.fecha)).slice(0, 30);
    },

    auditoriasOrdenadas() {
      return this.auditorias.slice().sort((a, b) => new Date(b.fecha) - new Date(a.fecha));
    },

    listaVenta() {
      const q = this.busqVenta.toLowerCase().trim();
      if (!q) return this.productosActivos.slice(0, 10);
      return this.productosActivos.filter(p => p.nombre.toLowerCase().includes(q)).slice(0, 10);
    },

    auditConteoActual() {
      if (!this.auditActiva) return [];
      const conteos = this.auditForm.conteos || {};
      return this.insumosActivos.map(i => {
        const c = conteos[i.id] || {};
        const teorico = m(this.stockInsumo(i.id));
        const contado = c.contado !== '' && c.contado !== undefined ? n(c.contado) : null;
        return {
          insumoId: i.id,
          nombre: i.nombre,
          unidad: i.unidad,
          stockTeorico: teorico,
          contado,
          dif: contado !== null ? m(contado - teorico) : 0
        };
      });
    },

    // Totales carrito
    totalCarrito() {
      return m(this.carrito.reduce((s, it) => s + (n(it.precio) * n(it.cant)), 0));
    },

    gananciaCarrito() {
      let gan = 0;
      for (const it of this.carrito) {
        const f = this.calcFIFOProducto(it.productoId, n(it.cant));
        if (!f.error) gan = m(gan + ((n(it.precio) * n(it.cant)) - f.costoTotal));
      }
      return m(gan);
    },

    masActivo() {
      return this.masAbierto || ['bajas','auditoria','productos','gastos','reportes','caja','socios'].includes(this.sec);
    }
  },

  methods: {
    fmt, fmtCant, fmtFecha, fmtFH, n, m,

    // ===== HELPERS =====
    stockInsumo(id) { return this.stockInsumosMap[id] || 0; },

    badgeStockInsumo(i) {
      const s = this.stockInsumo(i.id);
      if (s <= 0) return 'out';
      if (s <= n(i.stockMinimo)) return 'low';
      return 'ok';
    },

    txtBadgeInsumo(i) {
      const s = this.stockInsumo(i.id);
      if (s <= 0) return 'AGOTADO';
      if (s <= n(i.stockMinimo)) return 'BAJO';
      return 'OK';
    },

    labelMotivo(v) {
      const m = MOTIVOS_BAJA.find(x => x.value === v);
      return m ? m.label : v;
    },

    toastMsg(msg, type = 'ok', accionTxt = '', accionFn = null) {
      clearTimeout(this.toast.timer);
      this.toast = { show: true, msg, type, accionTxt, accionFn, timer: null };
      vib(type === 'ok' ? 20 : 40);
      this.toast.timer = setTimeout(() => { this.toast.show = false; }, accionTxt ? 5000 : 3000);
    },

    toggleTema() {
      this.cfg.tema = this.cfg.tema === 'dark' ? 'light' : 'dark';
      try { document.documentElement.setAttribute('data-theme', this.cfg.tema); } catch (e) {}
      this.guardarCfg();
    },

    ir(s) {
      this.masAbierto = false;
      this.sec = s;
      try { history.pushState({ sec: s }, '', '#' + s); } catch (e) {}
    },

    setCapitalInicial(val) {
      const nuevo = n(val);
      this.cfg.capitalInicial = nuevo;
      this.guardarCfg();
      this.toastMsg('Capital inicial: ' + fmt(nuevo));
    },

    // ===== FIFO INSUMOS =====
    calcFIFOInsumo(insumoId, cant) {
      const lotes = this.lotesInsumo
        .filter(l => l.insumoId === insumoId && (n(l.cantidadInicial) - n(l.cantidadUsada)) > 0)
        .sort((a, b) => new Date(a.fecha) - new Date(b.fecha) || (a.id < b.id ? -1 : 1));
      let rest = cant, total = 0, usados = [];
      for (const l of lotes) {
        if (rest <= 0) break;
        const disp = n(l.cantidadInicial) - n(l.cantidadUsada);
        const usar = Math.min(disp, rest);
        total = m(total + (usar * n(l.costo)));
        usados.push({ loteId: l.id, cantidad: usar, costo: n(l.costo) });
        rest -= usar;
      }
      if (rest > 0.001) return { error: 'Stock insuficiente (faltan ' + fmtCant(rest) + ')' };
      return { costoTotal: total, usados };
    },

    calcFIFOProducto(productoId, cant) {
      const p = this.productos.find(x => x.id === productoId);
      if (!p) return { error: 'Producto no encontrado' };
      const receta = p.receta || [];
      if (receta.length === 0) return { costoTotal: 0, usados: [] };
      let total = 0;
      const todos = [];
      for (const r of receta) {
        const cantInsumo = n(r.cantidad) * cant;
        const f = this.calcFIFOInsumo(r.insumoId, cantInsumo);
        if (f.error) return { error: p.nombre + ': ' + f.error };
        total = m(total + f.costoTotal);
        todos.push(...f.usados.map(u => ({ insumoId: r.insumoId, ...u })));
      }
      return { costoTotal: total, usados: todos };
    },

    // ===== VENTAS =====
    agregarCarrito(p) {
      const ex = this.carrito.find(i => i.productoId === p.id);
      if (ex) ex.cant = String(n(ex.cant) + 1);
      else this.carrito.push({ productoId: p.id, nombre: p.nombre, precio: String(p.precio), cant: '1' });
      this.busqVenta = '';
    },

    cambiarCant(it, dir) {
      let val = n(it.cant) + dir;
      if (val < 0) val = 0;
      it.cant = String(val);
    },

    subTotalItem(it) { return m(n(it.precio) * n(it.cant)); },

    iniciarCobro() {
      const inv = this.carrito.filter(it => n(it.cant) <= 0);
      if (inv.length) return this.toastMsg('Cantidades deben ser > 0', TOAST.BAD);
      this.cobroModal.total = this.totalCarrito;
      this.cobroModal.activo = true;
    },

    async procesarVenta() {
      this.procesandoVenta = true;
      try {
        const items = []; let tot = 0, gan = 0, todos = [];
        for (const it of this.carrito) {
          const c = n(it.cant), pr = n(it.precio);
          const f = this.calcFIFOProducto(it.productoId, c);
          if (f.error) throw new Error(f.error);
          const sub = pr * c;
          items.push({
            productoId: it.productoId, nombre: it.nombre, cantidad: c,
            precio: pr, costo: f.costoTotal,
            ganancia: m(sub - f.costoTotal), insumosUsados: f.usados
          });
          tot = m(tot + sub);
          gan = m(gan + (sub - f.costoTotal));
          todos.push(...f.usados);
        }
        const venta = { id: genId('v'), fecha: new Date().toISOString(), items, total: tot, ganancia: gan, anulada: false };

        await db.transaction('rw', db.ventas, db.lotesInsumo, async () => {
          await P(db.ventas, venta);
          const lotesAct = [];
          for (const u of todos) {
            const l = this.lotesInsumo.find(x => x.id === u.loteId);
            if (l) {
              l.cantidadUsada = q(n(l.cantidadUsada) + u.cantidad);
              lotesAct.push(l);
            }
          }
          if (lotesAct.length) await db.lotesInsumo.bulkPut(lotesAct.map(l => clean(l)));
        });

        await this.recargar(['ventas', 'lotesInsumo']);
        this.carrito = [];
        this.cobroModal.activo = false;
        this.procesandoVenta = false;
        this.toastMsg('Venta exitosa: ' + fmt(tot));
      } catch (e) {
        this.toastMsg(e.message, TOAST.BAD);
      } finally {
        this.procesandoVenta = false;
      }
    },

    anularVenta(id) {
      const v = this.ventas.find(x => x.id === id);
      if (!v) return;
      this.confirm = {
        activo: true, titulo: 'Anular venta',
        msg: '¿Anular venta por ' + fmt(v.total) + '?',
        onOk: async () => {
          try {
            await db.transaction('rw', db.ventas, db.lotesInsumo, async () => {
              await P(db.ventas, { ...v, anulada: true, fechaAnulacion: new Date().toISOString() });
              const lotesAct = [];
              for (const it of v.items) {
                if (!it.insumosUsados) continue;
                for (const u of it.insumosUsados) {
                  const l = this.lotesInsumo.find(x => x.id === u.loteId);
                  if (l) {
                    l.cantidadUsada = Math.max(0, q(n(l.cantidadUsada) - u.cantidad));
                    lotesAct.push(l);
                  }
                }
              }
              if (lotesAct.length) await db.lotesInsumo.bulkPut(lotesAct.map(l => clean(l)));
            });
            await this.recargar(['ventas', 'lotesInsumo']);
            this.toastMsg('Venta anulada');
          } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
        }
      };
    },

    // ===== COMPRAS =====
    selCompraInsumo() {
      const i = this.insumos.find(x => x.id === this.compraForm.insumoId);
      if (!i) return;
      this.compraForm.insumoNombre = i.nombre;
      this.compraForm.unidad = i.unidad;
      this.compraForm.pesoEnvase = String(i.pesoEnvase || '');
    },

    compraCantidadNeta() {
      return m(n(this.compraForm.pesoBruto) - n(this.compraForm.pesoEnvase));
    },

    compraCostoUnitario() {
      const neta = this.compraCantidadNeta();
      return neta > 0 ? m(n(this.compraForm.costoTotal) / neta) : 0;
    },

    resetCompra() {
      this.compraForm = { insumoId: '', insumoNombre: '', unidad: 'g', pesoBruto: '', pesoEnvase: '', costoTotal: '' };
    },

    async guardarCompra() {
      const f = this.compraForm;
      const neto = this.compraCantidadNeta();
      const costoTotal = n(f.costoTotal);
      if (!f.insumoId) return this.toastMsg('Selecciona insumo', TOAST.BAD);
      if (neto <= 0) return this.toastMsg('Cantidad neta debe ser > 0', TOAST.BAD);
      if (costoTotal <= 0) return this.toastMsg('Costo debe ser > 0', TOAST.BAD);
      const costoUnit = m(costoTotal / neto);
      try {
        const compra = {
          id: genId('c'), fecha: new Date().toISOString(),
          insumoId: f.insumoId, insumoNombre: f.insumoNombre,
          cantidad: neto, unidad: f.unidad,
          pesoBruto: n(f.pesoBruto), pesoEnvase: n(f.pesoEnvase),
          costo: costoUnit, total: costoTotal
        };
        const lote = {
          id: genId('li'), compraId: compra.id,
          insumoId: f.insumoId, insumoNombre: f.insumoNombre,
          cantidadInicial: neto, cantidadUsada: 0,
          costo: costoUnit, fecha: compra.fecha, unidad: f.unidad
        };
        await db.transaction('rw', db.compras, db.lotesInsumo, async () => {
          await P(db.compras, compra);
          await P(db.lotesInsumo, lote);
        });
        await this.recargar(['compras', 'lotesInsumo']);
        this.resetCompra();
        this.toastMsg('Compra registrada: ' + fmt(costoTotal));
      } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
    },

    // ===== INSUMOS =====
    async guardarInsumo() {
      const f = this.insumoForm;
      if (!f.nombre.trim()) return this.toastMsg('Nombre obligatorio', TOAST.BAD);
      const dup = this.insumos.find(i => i.nombre.toLowerCase() === f.nombre.trim().toLowerCase() && !i.archivado);
      if (dup) return this.toastMsg('Ya existe ese insumo', TOAST.BAD);
      try {
        await P(db.insumos, {
          id: genId('i'), nombre: f.nombre.trim(),
          unidad: f.unidad, categoria: f.categoria,
          stockMinimo: n(f.stockMinimo) || 0,
          pesoEnvase: n(f.pesoEnvase) || 0,
          archivado: false, fechaCreacion: new Date().toISOString()
        });
        await this.recargar(['insumos']);
        this.insumoForm = { nombre: '', unidad: 'g', categoria: '', stockMinimo: '', pesoEnvase: '' };
        this.toastMsg('Insumo agregado');
      } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
    },

    // ===== PRODUCTOS =====
    agregarIngredienteReceta() {
      if (!this.prodForm.receta) this.prodForm.receta = [];
      this.prodForm.receta.push({ insumoId: '', cantidad: '', fijo: false });
    },

    quitarIngredienteReceta(i) {
      this.prodForm.receta.splice(i, 1);
    },

    resetProd() {
      this.prodForm = { editId: '', nombre: '', precio: '', receta: [] };
    },

    async guardarProducto() {
      const f = this.prodForm;
      if (!f.nombre.trim()) return this.toastMsg('Nombre obligatorio', TOAST.BAD);
      if (n(f.precio) <= 0) return this.toastMsg('Precio > 0', TOAST.BAD);
      const dup = this.productos.find(p => p.nombre.toLowerCase() === f.nombre.trim().toLowerCase() && p.id !== f.editId);
      if (dup) return this.toastMsg('Ya existe ese producto', TOAST.BAD);
      const receta = (f.receta || [])
        .filter(r => r.insumoId && n(r.cantidad) > 0)
        .map(r => ({ insumoId: r.insumoId, cantidad: n(r.cantidad), fijo: !!r.fijo }));
      try {
        if (f.editId) {
          const o = this.productos.find(x => x.id === f.editId);
          await P(db.productos, { ...o, nombre: f.nombre.trim(), precio: n(f.precio), receta });
          this.toastMsg('Producto actualizado');
        } else {
          await P(db.productos, {
            id: genId('p'), nombre: f.nombre.trim(), precio: n(f.precio),
            receta, archivado: false, fechaCreacion: new Date().toISOString()
          });
          this.toastMsg('Producto agregado');
        }
        this.resetProd();
        await this.recargar(['productos']);
      } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
    },

    editarProducto(id) {
      const p = this.productos.find(x => x.id === id);
      if (!p) return;
      this.prodForm = {
        editId: id, nombre: p.nombre, precio: String(p.precio),
        receta: (p.receta || []).map(r => ({ insumoId: r.insumoId, cantidad: String(r.cantidad), fijo: !!r.fijo }))
      };
      window.scrollTo(0, 0);
    },

    // ===== BAJAS =====
    async registrarBaja() {
      const f = this.bajaForm;
      const cant = n(f.cantidad);
      if (!f.productoId) return this.toastMsg('Selecciona producto', TOAST.BAD);
      if (cant <= 0) return this.toastMsg('Cantidad > 0', TOAST.BAD);
      if (!f.motivo) return this.toastMsg('Selecciona motivo', TOAST.BAD);
      const p = this.productos.find(x => x.id === f.productoId);
      const fifo = this.calcFIFOProducto(f.productoId, cant);
      if (fifo.error) return this.toastMsg(fifo.error, TOAST.BAD);
      try {
        const baja = {
          id: genId('b'), fecha: new Date().toISOString(),
          productoId: f.productoId, productoNombre: p.nombre,
          cantidad: cant, motivo: f.motivo, nota: f.nota || '',
          costoPerdida: fifo.costoTotal, insumosUsados: fifo.usados
        };
        await db.transaction('rw', db.bajas, db.lotesInsumo, async () => {
          await P(db.bajas, baja);
          const lotesAct = [];
          for (const u of fifo.usados) {
            const l = this.lotesInsumo.find(x => x.id === u.loteId);
            if (l) { l.cantidadUsada = q(n(l.cantidadUsada) + u.cantidad); lotesAct.push(l); }
          }
          if (lotesAct.length) await db.lotesInsumo.bulkPut(lotesAct.map(l => clean(l)));
        });
        await this.recargar(['bajas', 'lotesInsumo']);
        this.bajaForm = { productoId: '', cantidad: '', motivo: '', nota: '' };
        this.toastMsg('Baja registrada: ' + fmt(fifo.costoTotal), TOAST.WARN);
      } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
    },

    // ===== AUDITORIA =====
    iniciarAuditoria() {
      this.auditForm = { conteos: {} };
      this.auditActiva = { id: genId('a'), fechaInicio: new Date().toISOString(), estado: 'en_progreso' };
      this.toastMsg('Auditoría iniciada');
    },

    cancelarAuditoria() {
      this.confirm = {
        activo: true, titulo: 'Cancelar auditoría',
        msg: '¿Descartar el progreso actual?',
        onOk: () => {
          this.auditActiva = null;
          this.auditForm = { conteos: {} };
        }
      };
    },

    setAuditConteo(id, val) {
      if (!this.auditForm.conteos[id]) this.auditForm.conteos[id] = {};
      this.auditForm.conteos[id].contado = val;
    },

    async cerrarAuditoria() {
      if (!this.auditActiva) return;
      const conteos = this.auditConteoActual.filter(c => c.contado !== null);
      if (conteos.length === 0) return this.toastMsg('Cuenta al menos 1 insumo', TOAST.BAD);
      try {
        const ajustesRecetas = [];
        const ventasPer = this.ventas.filter(v => !v.anulada && new Date(v.fecha) >= new Date(this.cfg.periodoInicio));
        const bajasPer = this.bajas.filter(b => new Date(b.fecha) >= new Date(this.cfg.periodoInicio));
        // Para cada insumo, calcular consumo real y comparar con el teórico
        for (const c of conteos) {
          const insumo = this.insumos.find(i => i.id === c.insumoId);
          if (!insumo) continue;
          const comprasIns = this.compras.filter(co => co.insumoId === c.insumoId && new Date(co.fecha) >= new Date(this.cfg.periodoInicio));
          const totalCompras = comprasIns.reduce((s, co) => s + n(co.cantidad), 0);
          const stockIni = 0; // simplificado: asumimos 0 al inicio del período
          const stockFin = n(c.contado);
          const consumoReal = m(stockIni + totalCompras - stockFin);
          // Consumo teórico (ventas + bajas)
          let consumoTeorico = 0;
          for (const v of ventasPer) {
            for (const it of v.items) {
              const prod = this.productos.find(x => x.id === it.productoId);
              if (!prod || !prod.receta) continue;
              const rec = prod.receta.find(r => r.insumoId === c.insumoId);
              if (rec) consumoTeorico += n(rec.cantidad) * n(it.cantidad);
            }
          }
          for (const b of bajasPer) {
            const prod = this.productos.find(x => x.id === b.productoId);
            if (!prod || !prod.receta) continue;
            const rec = prod.receta.find(r => r.insumoId === c.insumoId);
            if (rec) consumoTeorico += n(rec.cantidad) * n(b.cantidad);
          }
          // Ajustar receta con suavizado
          const totalPizzas = ventasPer.reduce((s, v) => s + v.items.reduce((ss, it) => ss + n(it.cantidad), 0), 0)
                            + bajasPer.reduce((s, b) => s + n(b.cantidad), 0);
          if (totalPizzas > 0 && consumoReal > 0) {
            const recetaCalculada = m(consumoReal / totalPizzas);
            // Suavizado: 0.8 viejo + 0.2 nuevo
            for (const prod of this.productos) {
              if (!prod.receta) continue;
              const rec = prod.receta.find(r => r.insumoId === c.insumoId);
              if (!rec || rec.fijo) continue;
              const viejo = n(rec.cantidad);
              const nuevo = m(0.8 * viejo + 0.2 * recetaCalculada);
              if (Math.abs(nuevo - viejo) > 0.01) {
                ajustesRecetas.push({
                  productoId: prod.id, productoNombre: prod.nombre,
                  insumoId: c.insumoId, insumoNombre: insumo.nombre,
                  cantidadVieja: viejo, cantidadNueva: nuevo
                });
              }
            }
          }
        }
        // Aplicar ajustes a productos
        for (const aj of ajustesRecetas) {
          const prod = this.productos.find(x => x.id === aj.productoId);
          if (!prod) continue;
          const nuevaReceta = prod.receta.map(r => r.insumoId === aj.insumoId ? { ...r, cantidad: aj.cantidadNueva } : r);
          await P(db.productos, { ...prod, receta: nuevaReceta });
        }
        // Guardar auditoría
        const auditoria = {
          id: this.auditActiva.id,
          fecha: new Date().toISOString(),
          fechaInicio: this.auditActiva.fechaInicio,
          fechaFin: new Date().toISOString(),
          estado: 'cerrada',
          conteos: conteos.map(c => ({ insumoId: c.insumoId, nombre: c.nombre, stockTeorico: c.stockTeorico, stockReal: c.contado, diferencia: c.dif })),
          ventasPeriodo: ventasPer.length,
          bajasPeriodo: bajasPer.length,
          ajustesRecetas,
          mermaExplicada: ajustesRecetas.length === 0
        };
        await P(db.auditorias, auditoria);
        await this.recargar(['auditorias', 'productos']);
        this.auditActiva = null;
        this.auditForm = { conteos: {} };
        this.toastMsg('Auditoría cerrada · ' + ajustesRecetas.length + ' receta(s) ajustada(s)');
      } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
    },

    // ===== CAJA =====
    calcArqueo() {
      const fisico = n(this.arqueoForm.monto);
      const diff = m(fisico - this.saldoCaja);
      this.arqueoPreview = { diff, class: Math.abs(diff) < 0.01 ? 'cuadre' : (diff > 0 ? 'sobrante' : 'faltante') };
    },

    async registrarArqueo() {
      const monto = n(this.arqueoForm.monto);
      if (this.arqueoForm.monto === '') return this.toastMsg('Monto inválido', TOAST.BAD);
      const diff = m(monto - this.saldoCaja);
      try {
        const arq = { id: genId('aq'), fecha: new Date().toISOString(), montoFisico: monto, saldoSistema: this.saldoCaja, diferencia: diff, nota: this.arqueoForm.nota || '' };
        if (Math.abs(diff) > 0.01) {
          const mov = { id: genId('mc'), fecha: new Date().toISOString(), tipo: diff > 0 ? 'ingreso' : 'egreso', monto: Math.abs(diff), concepto: (diff > 0 ? 'Sobrante' : 'Faltante') + ' de arqueo' };
          await db.transaction('rw', db.arqueos, db.movCaja, async () => {
            await P(db.arqueos, arq);
            await P(db.movCaja, mov);
          });
        } else {
          await P(db.arqueos, arq);
        }
        await this.recargar(['arqueos', 'movCaja']);
        this.arqueoForm = { monto: '', nota: '' };
        this.arqueoPreview = { diff: 0, class: 'cuadre' };
        this.toastMsg(diff === 0 ? 'Cuadre perfecto' : 'Arqueo: ' + fmt(diff), diff === 0 ? 'ok' : 'warn');
      } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
    },

    // ===== GASTOS =====
    async guardarGasto() {
      const f = this.gastoForm;
      if (!f.categoria) return this.toastMsg('Categoría obligatoria', TOAST.BAD);
      if (!f.concepto.trim()) return this.toastMsg('Concepto obligatorio', TOAST.BAD);
      if (n(f.monto) <= 0) return this.toastMsg('Monto > 0', TOAST.BAD);
      try {
        const gasto = {
          id: genId('g'), fecha: f.fecha ? new Date(f.fecha + 'T12:00:00').toISOString() : new Date().toISOString(),
          categoria: f.categoria, concepto: f.concepto.trim(), monto: n(f.monto),
          saleDeCaja: !!f.saleDeCaja
        };
        await P(db.gastos, gasto);
        if (f.saleDeCaja) {
          await P(db.movCaja, { id: genId('mc'), fecha: gasto.fecha, tipo: 'egreso', monto: gasto.monto, concepto: 'Gasto: ' + gasto.concepto });
        }
        await this.recargar(['gastos', 'movCaja']);
        this.gastoForm = { fecha: new Date().toISOString().split('T')[0], categoria: '', concepto: '', monto: '', saleDeCaja: true };
        this.toastMsg('Gasto registrado: ' + fmt(gasto.monto));
      } catch (e) { this.toastMsg(e.message, TOAST.BAD); }
    },

    // ===== REPORTES =====
    generarReporte() {
      const ini = new Date(this.rep.fechaInicio);
      const fin = new Date(this.rep.fechaFin); fin.setHours(23, 59, 59, 999);
      if (ini > fin) return this.toastMsg('Fecha inicio > fin', TOAST.BAD);
      const vp = this.ventas.filter(v => !v.anulada && new Date(v.fecha) >= ini && new Date(v.fecha) <= fin);
      const bp = this.bajas.filter(b => new Date(b.fecha) >= ini && new Date(b.fecha) <= fin);
      const gp = this.gastos.filter(g => new Date(g.fecha) >= ini && new Date(g.fecha) <= fin);
      const ingresos = m(vp.reduce((s, v) => s + n(v.total), 0));
      const costoInsumos = m(vp.reduce((s, v) => s + v.items.reduce((ss, it) => ss + n(it.costo), 0), 0));
      const bajas = m(bp.reduce((s, b) => s + n(b.costoPerdida), 0));
      const gastos = m(gp.reduce((s, g) => s + n(g.monto), 0));
      const neta = m(ingresos - costoInsumos - bajas - gastos);
      this.rep.resultado = { ingresos, costoInsumos, bajas, gastos, neta, numVentas: vp.length };
      this.toastMsg('Reporte generado');
    },

    // ===== DATOS =====
    async guardarCfg() {
      try { await P(db.config, { key: 'cfg', value: this.cfg }); } catch (e) { console.error('guardarCfg', e); }
    },

    async recargar(what) {
      const map = {
        insumos: () => db.insumos.toArray(),
        lotesInsumo: () => db.lotesInsumo.toArray(),
        productos: () => db.productos.toArray(),
        ventas: () => db.ventas.toArray(),
        compras: () => db.compras.toArray(),
        bajas: () => db.bajas.toArray(),
        gastos: () => db.gastos.toArray(),
        movCaja: () => db.movCaja.toArray(),
        arqueos: () => db.arqueos.toArray(),
        auditorias: () => db.auditorias.toArray(),
        socios: () => db.socios.toArray(),
        distribuciones: () => db.distribuciones.toArray(),
        capital: () => db.capital.toArray(),
        retiros: () => db.retiros.toArray()
      };
      for (const w of what) this[w] = await map[w]();
      this._stockCache = null;
    },

    async recargarTodo() {
      const tables = ['insumos','lotesInsumo','productos','ventas','compras','bajas','gastos','movCaja','arqueos','auditorias','socios','distribuciones','capital','retiros'];
      let r;
      await db.transaction('r', tables.map(t => db.table(t)), async () => {
        r = await Promise.all(tables.map(t => db.table(t).toArray()));
      });
      tables.forEach((k, i) => this[tables[i]] = r[i]);
      this._stockCache = null;
    },

    exportar() {
      const d = buildData(this);
      const blob = new Blob([JSON.stringify(d, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'respaldo-pizzeria-' + new Date().toISOString().split('T')[0] + '.json';
      a.click();
      URL.revokeObjectURL(a.href);
      this.toastMsg('Respaldo descargado');
    },

    triggerImport() {
      const el = document.getElementById('impFile');
      if (el) el.click();
    },

    onImportFile(e) {
      const file = e.target.files[0];
      if (!file) return;
      e.target.value = '';
      const rd = new FileReader();
      rd.onload = async (ev) => {
        try {
          const d = JSON.parse(ev.target.result);
          if (!d.productos && !d.ventas) throw new Error('Archivo inválido');
          const tables = ['insumos','lotesInsumo','productos','ventas','compras','bajas','gastos','movCaja','arqueos','auditorias'];
          await db.transaction('rw', tables.concat(['config']), async () => {
            for (const t of tables) {
              await db.table(t).clear();
              if (Array.isArray(d[t])) await db.table(t).bulkPut(clean(d[t]));
            }
            if (d.cfg) await P(db.config, { key: 'cfg', value: d.cfg });
          });
          if (d.cfg) this.cfg = { ...this.cfg, ...d.cfg };
          await this.recargarTodo();
          this.ajustesAbierto = false;
          this.toastMsg('Datos importados');
        } catch (e) { this.toastMsg('Error: ' + e.message, TOAST.BAD); }
      };
      rd.readAsText(file);
    },

    borrarTodo() {
      this.confirm = {
        activo: true, titulo: '⚠ BORRAR TODO',
        msg: 'Esto eliminará PERMANENTEMENTE todos los datos. No se puede deshacer.',
        onOk: () => {
          this.prompt = {
            activo: true, titulo: 'Confirmación final',
            msg: 'Escribe BORRAR (en mayúsculas) para confirmar:',
            placeholder: 'BORRAR', type: 'text', value: '',
            onOk: async (v) => {
              if (v !== 'BORRAR') return this.toastMsg('Cancelado', TOAST.WARN);
              try {
                const tables = ['insumos','lotesInsumo','productos','ventas','compras','bajas','gastos','movCaja','arqueos','auditorias'];
                await db.transaction('rw', tables.concat(['config']), async () => {
                  for (const t of tables) await db.table(t).clear();
                  await db.config.clear();
                });
                this.toastMsg('Todos los datos eliminados');
                setTimeout(() => location.reload(), 1200);
              } catch (e) { this.toastMsg('Error: ' + e.message, TOAST.BAD); }
            }
          };
        }
      };
    },

    // ===== MODALES =====
    okConfirm() { const cb = this.confirm.onOk; this.confirm.activo = false; if (cb) cb(); },
    okPrompt() { const cb = this.prompt.onOk; const v = this.prompt.value; this.prompt.activo = false; if (cb) cb(v); },
    cancelPrompt() { this.prompt.activo = false; },

    // ===== PULL TO REFRESH =====
    onTouchStart(e) {
      if (window.scrollY > 0) return;
      this._pullStartY = e.touches[0].clientY;
      this._pulling = true;
    },
    onTouchMove(e) {
      if (!this._pulling) return;
      const dy = e.touches[0].clientY - this._pullStartY;
      if (dy > 0) this.pullDist = Math.min(dy, 90);
    },
    onTouchEnd() {
      if (!this._pulling) return;
      if (this.pullDist >= 70) { this.refrescando = true; setTimeout(() => { this.refrescando = false; this.pullDist = 0; }, 500); }
      this._pulling = false;
      setTimeout(() => { this.pullDist = 0; }, 300);
    },

    // ===== INICIALIZACIÓN =====
    async inicializar() {
      try {
        const c = await db.config.get('cfg');
        if (c) this.cfg = { ...this.cfg, ...c.value };
        else await this.guardarCfg();
        try {
          document.documentElement.setAttribute('data-theme', this.cfg.tema);
        } catch (e) {}
        await this.recargarTodo();
        const hash = location.hash.slice(1);
        const valid = ['dashboard','ventas','compras','inventario','bajas','productos','auditoria','caja','gastos','reportes','socios'];
        if (valid.includes(hash)) this.sec = hash;
      } catch (e) {
        console.error(e);
        this.toastMsg('Error al cargar datos', TOAST.BAD);
      } finally {
        this.cargando = false;
        this.splashVisible = false;
      }
    }
  },

  watch: {
    'cfg.tema'(t) {
      try { document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    },
    'arqueoForm.monto'() {
      this.calcArqueo();
    }
  },

  provide() {
    return { $app: this };
  },

  mounted() {
    this.inicializar();
    window.addEventListener('online', () => this.online = true);
    window.addEventListener('offline', () => this.online = false);
    window.addEventListener('popstate', e => { this.sec = (e.state && e.state.sec) || 'dashboard'; });
  }
};
</script>

